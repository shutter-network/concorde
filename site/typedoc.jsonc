{
  "$schema": "https://typedoc.org/schema.json",

  "name": "shared-agent-framework",

  // Two local plugins. `specifier-titles.mjs` is what makes a page name the specifier it is
  // reached through; see the file for why TypeDoc's own module names will not do.
  // `expanded-object-methods.mjs` defines the theme named below, and it is what `expandObjects`
  // needs to be honest; see the file, and the `theme` line at the bottom.
  "plugin": [
    "typedoc-plugin-markdown",
    "typedoc-vitepress-theme",
    "./specifier-titles.mjs",
    "./expanded-object-methods.mjs"
  ],

  // The nine entry points of the export map, in the order `package.json` lists them
  // ([ADR-0047](../docs/adr/0047-a-component-is-one-subpath.md)). `example/` is not among
  // them: it is the reference deployment, not public API, so it is absent from the reference.
  // `specifier-titles.mjs` compares this list against `exports` both ways and fails the
  // generation if they disagree, so an entry point added to one and not the other is loud.
  "entryPoints": [
    "../src/index.ts",
    "../src/signals/index.ts",
    "../src/pi/index.ts",
    "../src/users/index.ts",
    "../src/messenger/index.ts",
    "../src/http-channel/index.ts",
    "../src/signatures/index.ts",
    "../src/decisions/index.ts",
    "../src/scheduler/index.ts"
  ],
  "entryPointStrategy": "resolve",

  // The build's own program, so the reference documents exactly what ships: `rootDir` is
  // `src` and tests and test support are excluded. The compiler that reads it is this
  // package's TypeScript 6, not the root's 7 — that is the whole reason `site/` exists.
  "tsconfig": "../tsconfig.build.json",

  // `reference/` is generated in full and wiped on every run, which is why it holds no
  // authored file: `.vitepress/` sits beside it, not inside it.
  "out": "./reference",
  "docsRoot": "./reference",

  // One file per entry point rather than one per exported symbol, so the whole public
  // surface is nine files and a diff of it is readable. `flattenOutputFiles` is what keeps
  // the eight subpath modules from nesting inside a directory named after the root module.
  "outputFileStrategy": "modules",
  "flattenOutputFiles": true,

  // No `Defined in` line under every symbol. TypeDoc writes those with a file path, a line
  // number and a commit hash, and the plan is to commit the rendered reference so that a
  // change to the public API arrives as a readable diff. Line numbers and a hash would churn
  // that diff on edits which changed no public API, which is the one thing committing it is
  // for. The repository is private, so the links resolve for nobody anyway.
  "disableSources": true,

  // Nothing but the reference. No README page, and no page for a symbol this package did not
  // declare.
  "readme": "none",
  "excludeExternals": true,
  "excludePrivate": true,
  "excludeInternal": true,

  // A warning fails the generation, and therefore `check:docs`. TypeDoc's loudest warning is the
  // dangling reference: a public signature naming a type that is on no specifier, which renders as
  // dead text a Developer cannot follow and cannot import. There was one of those, tolerated
  // because fixing it meant changing the export map and a documentation check does not get to
  // force that at an unrelated moment. There is none now (issue 09), so tolerating buys nothing
  // and hides the next one. Nothing else in the repository scans for it: committing the reference
  // catches a *stale* page, not a page that is honestly rendered and says `CursorWindow` to a
  // reader who cannot type it. What this costs is that an export a doc comment references but no
  // subpath carries now fails a CI step, which is the moment to notice it.
  "treatWarningsAsErrors": true,

  // TypeDoc's default grouping by kind is kept and no custom group is declared: a component's
  // tables land under Variables and its constructor under Functions, which separates them
  // without hiding either. The page header and breadcrumb are dropped because the title is
  // already the specifier and there are only nine pages to be lost among.
  "hidePageHeader": true,
  "hideBreadcrumbs": true,
  "useCodeBlocks": true,

  // The block above an object type prints its members rather than the word `object`. It is the
  // first thing on a page and it is what a reader takes the shape from, and most of this public
  // API is object literals, so collapsed it left the shape to be assembled by hand out of the
  // sections below on all nine pages.
  //
  // **It cannot be set without the theme on the next line.** The plugin renders each member from
  // `getDeclarationType`, which answers a method with the return type of its first signature, so
  // `expandObjects` alone prints about forty methods as properties holding their own return
  // value. `expanded-object-methods.mjs` widens that one helper inside an expanded object and
  // says why at length; setting this and dropping that plugin ships a block a reader is wrong to
  // trust.
  "expandObjects": true,
  "theme": "expanded-objects"
}
