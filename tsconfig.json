{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    // Source imports carry `.ts` extensions so Node's type stripping can run
    // this tree directly; tsc rewrites them to `.js` when it emits.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    // Node strips types rather than compiling them, so anything that needs a
    // code transform (enums, namespaces, parameter properties) must not appear.
    "erasableSyntaxOnly": true,

    "skipLibCheck": true,
    "noEmit": true

    // No `paths`. There were fifteen, one per subpath of the export map, and they existed
    // for one reader: `example/`, which lived in this tree, imported the package by name and
    // had to type-check before `dist` was built. Every example is its own npm application
    // now and resolves `shared-agent-framework` out of its own `node_modules`, so a mapping
    // here would serve nothing and cost something: anything that did resolve through it
    // would silently get `src` in place of the installed package, which is the one
    // difference an example exists to not have.
  },
  // `src` and `scripts`, and nothing under `examples/`. Each example carries a
  // `tsconfig.json` of its own and is checked by a step of its own in CI, against the
  // version it pins rather than against this tree.
  "include": ["src", "scripts"]
}
