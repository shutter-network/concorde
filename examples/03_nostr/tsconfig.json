{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "strict": true,
    "verbatimModuleSyntax": true,

    // Node 24 runs these files by stripping types, so there is no build step and an
    // import may name a `.ts` file.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,

    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["main.ts", "schema.ts", "drizzle.config.ts"]
}
