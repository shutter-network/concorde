{
  "name": "shared-agent-framework",
  "version": "0.0.0",
  "description": "A framework for building AI agents that serve several parties at once, where no single party may control the agent or reach it privately.",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/jannikluhn/shared-agent-framework.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pi": {
      "types": "./dist/pi/index.d.ts",
      "default": "./dist/pi/index.js"
    },
    "./messenger": null
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test \"src/**/*.test.ts\"",
    "check": "npm run typecheck && npm run build && npm run lint && npm test",
    "check:package": "node scripts/check-package.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.2",
    "drizzle-orm": "0.45.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "pg": "^8.22.0"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.2"
  }
}
