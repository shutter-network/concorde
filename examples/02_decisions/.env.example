# Copy this file to .env and fill in the one blank at the top.
ANTHROPIC_API_KEY=

# The two seeded passwords, which `main.ts` sets from trusted code on the first boot and the two
# `tui` services log in with. Handing a Gateway its users' plaintext passwords through the
# environment is a demo affordance so that `docker compose up` is the whole setup. Nothing about
# it is worth copying: a real deployment sets a password out of band and never holds one here.
ALICE_PASSWORD=correct horse battery staple
BOB_PASSWORD=chased by a dog on a bicycle
