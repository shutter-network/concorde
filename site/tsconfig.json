{
  // Bundler settings, not the framework's. VitePress compiles `.vitepress/config.ts` with
  // esbuild, which takes the nearest `tsconfig.json` above the file; without this one that is
  // the repository root's, and the root's is written for a compiler that emits nothing and for
  // sources whose relative imports carry `.ts` extensions. `strict` is here for an editor
  // opening `config.ts` rather than for the bundler, which ignores it — nothing type-checks
  // this tree, because `npm run check` does not know `site/` exists.
  //
  // It does not silence esbuild's "Unrecognized target environment es2024" warning: esbuild
  // validates every `tsconfig.json` on the way up, so the root's `target` is reported from
  // here whatever this file says. That line is cosmetic and the build passes with it.
  //
  // There is no `include`: Vite matches a file to a tsconfig by `include` and walks up when
  // nothing matches, so narrowing this would send the generated pages to the root config.
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true
  }
}
