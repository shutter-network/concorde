{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    // Source imports carry `.ts` extensions so Node's type stripping can run
    // this tree directly; tsc rewrites them to `.js` when it emits.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    // Node strips types rather than compiling them, so anything that needs a
    // code transform (enums, namespaces, parameter properties) must not appear.
    "erasableSyntaxOnly": true,

    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "scripts"]
}
