{
  "name": "shared-agent-framework",
  "version": "0.0.0",
  "description": "A framework for building AI agents that serve several parties at once, where no single party may control the agent or reach it privately.",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/jannikluhn/shared-agent-framework.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./signals": {
      "types": "./dist/signals/index.d.ts",
      "default": "./dist/signals/index.js"
    },
    "./pi": {
      "types": "./dist/pi/index.d.ts",
      "default": "./dist/pi/index.js"
    },
    "./users": {
      "types": "./dist/users/index.d.ts",
      "default": "./dist/users/index.js"
    },
    "./http-messenger": {
      "types": "./dist/http-messenger/index.d.ts",
      "default": "./dist/http-messenger/index.js"
    },
    "./signatures": {
      "types": "./dist/signatures/index.d.ts",
      "default": "./dist/signatures/index.js"
    },
    "./decisions": {
      "types": "./dist/decisions/index.d.ts",
      "default": "./dist/decisions/index.js"
    },
    "./scheduler": {
      "types": "./dist/scheduler/index.d.ts",
      "default": "./dist/scheduler/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:container": "SAF_CONTAINER_TESTS=1 node --test \"src/pi/container.test.ts\"",
    "check": "npm run typecheck && npm run build && npm run lint && npm test",
    "check:package": "node scripts/check-package.ts",
    "check:docs": "node scripts/check-docs.ts",
    "docs:dev": "npm --prefix site ci --no-audit --no-fund && npm --prefix site run dev",
    "docs:build": "npm --prefix site ci --no-audit --no-fund && npm --prefix site run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/luxon": "3.7.3",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.2",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "fastify": "5.11.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "cron-parser": "^5.7.0",
    "handlebars": "^4.7.9",
    "jose": "^6.2.8",
    "luxon": "^3.7.2",
    "pg": "^8.22.0",
    "pino": "^10.3.1"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.0"
  }
}
