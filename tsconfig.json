{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    // Source imports carry `.ts` extensions so Node's type stripping can run
    // this tree directly; tsc rewrites them to `.js` when it emits.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    // Node strips types rather than compiling them, so anything that needs a
    // code transform (enums, namespaces, parameter properties) must not appear.
    "erasableSyntaxOnly": true,

    "skipLibCheck": true,
    "noEmit": true,

    // `example/` imports the package by name, exactly as an Operator's entry point
    // does, and that is the point of it: the reference entry point has to read like
    // the thing it is a reference for, not like a file reaching into `src`. Node
    // resolves that by itself — a package may refer to its own `exports` — but it
    // resolves it to `dist`, which is generated and gitignored, so a typecheck
    // before a build would fail on a fresh clone. These two lines point the type
    // checker at the sources instead. Nothing in `src` imports the package by name,
    // so nothing else is affected.
    //
    // The `/schema` entries are here for the same reason and one more: they are the
    // subpaths an Operator's migration barrel is assembled from
    // ([ADR-0046](./docs/adr/0046-the-operator-owns-migrations.md)), and `example/` is
    // the reference Operator, so its barrel has to type-check against `src` exactly as
    // its entry point does.
    "paths": {
      "shared-agent-framework": ["./src/index.ts"],
      "shared-agent-framework/signals/schema": ["./src/signals/schema.ts"],
      "shared-agent-framework/pi": ["./src/pi/index.ts"],
      "shared-agent-framework/users": ["./src/users/index.ts"],
      "shared-agent-framework/users/schema": ["./src/users/schema.ts"],
      "shared-agent-framework/http-messenger": ["./src/http-messenger/index.ts"],
      "shared-agent-framework/http-messenger/schema": ["./src/http-messenger/schema.ts"],
      "shared-agent-framework/signatures": ["./src/signatures/index.ts"],
      "shared-agent-framework/decisions": ["./src/decisions/index.ts"],
      "shared-agent-framework/decisions/schema": ["./src/decisions/schema.ts"],
      "shared-agent-framework/scheduler": ["./src/scheduler/index.ts"],
      "shared-agent-framework/scheduler/schema": ["./src/scheduler/schema.ts"]
    }
  },
  // The `drizzle.*.config.ts` files are included but not built: they are how the
  // migration folders are generated, one per part, so a mistake in one should fail
  // the typecheck rather than the next person to run the generator. `example` is
  // included for the same reason — it is the reference deployment, and one that does
  // not compile is worse than none.
  "include": [
    "src",
    "scripts",
    "drizzle.config.ts",
    "drizzle.users.config.ts",
    "drizzle.http-messages.config.ts",
    "drizzle.decisions.config.ts",
    "drizzle.scheduler.config.ts",
    "example"
  ]
}
