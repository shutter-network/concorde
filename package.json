{
  "name": "shared-agent-framework",
  "version": "0.2.0",
  "description": "A framework for building AI agents that serve several parties at once, where no single party may control the agent or reach it privately.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jannikluhn/shared-agent-framework.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./gateway": {
      "types": "./dist/gateway/index.d.ts",
      "default": "./dist/gateway/index.js"
    },
    "./logging": {
      "types": "./dist/logging/index.d.ts",
      "default": "./dist/logging/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "default": "./dist/db/index.js"
    },
    "./agent-container": {
      "types": "./dist/agent-container/index.d.ts",
      "default": "./dist/agent-container/index.js"
    },
    "./signals": {
      "types": "./dist/signals/index.d.ts",
      "default": "./dist/signals/index.js"
    },
    "./signals/schema": {
      "types": "./dist/signals/schema/index.d.ts",
      "default": "./dist/signals/schema/index.js"
    },
    "./pi": {
      "types": "./dist/pi/index.d.ts",
      "default": "./dist/pi/index.js"
    },
    "./users": {
      "types": "./dist/users/index.d.ts",
      "default": "./dist/users/index.js"
    },
    "./users/schema": {
      "types": "./dist/users/schema/index.d.ts",
      "default": "./dist/users/schema/index.js"
    },
    "./password-auth": {
      "types": "./dist/password-auth/index.d.ts",
      "default": "./dist/password-auth/index.js"
    },
    "./password-auth/schema": {
      "types": "./dist/password-auth/schema/index.d.ts",
      "default": "./dist/password-auth/schema/index.js"
    },
    "./nostr-auth": {
      "types": "./dist/nostr-auth/index.d.ts",
      "default": "./dist/nostr-auth/index.js"
    },
    "./nostr-auth/schema": {
      "types": "./dist/nostr-auth/schema/index.d.ts",
      "default": "./dist/nostr-auth/schema/index.js"
    },
    "./messenger": {
      "types": "./dist/messenger/index.d.ts",
      "default": "./dist/messenger/index.js"
    },
    "./messenger/schema": {
      "types": "./dist/messenger/schema/index.d.ts",
      "default": "./dist/messenger/schema/index.js"
    },
    "./http-channel": {
      "types": "./dist/http-channel/index.d.ts",
      "default": "./dist/http-channel/index.js"
    },
    "./nostr-channel": {
      "types": "./dist/nostr-channel/index.d.ts",
      "default": "./dist/nostr-channel/index.js"
    },
    "./nostr-channel/schema": {
      "types": "./dist/nostr-channel/schema/index.d.ts",
      "default": "./dist/nostr-channel/schema/index.js"
    },
    "./signatures": {
      "types": "./dist/signatures/index.d.ts",
      "default": "./dist/signatures/index.js"
    },
    "./decisions": {
      "types": "./dist/decisions/index.d.ts",
      "default": "./dist/decisions/index.js"
    },
    "./decisions/schema": {
      "types": "./dist/decisions/schema/index.d.ts",
      "default": "./dist/decisions/schema/index.js"
    },
    "./scheduler": {
      "types": "./dist/scheduler/index.d.ts",
      "default": "./dist/scheduler/index.js"
    },
    "./scheduler/schema": {
      "types": "./dist/scheduler/schema/index.d.ts",
      "default": "./dist/scheduler/schema/index.js"
    }
  },
  "bin": {
    "http-client-tui": "./dist/http-client-tui/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:container": "SAF_CONTAINER_TESTS=1 node --test \"src/pi/container.test.ts\"",
    "check": "npm run typecheck && npm run build && npm run lint && npm test",
    "check:package": "node scripts/check-package.ts",
    "extract:routes": "node scripts/reference/extract-routes.ts",
    "extract:schema": "node scripts/reference/extract-schema.ts",
    "check:docs": "node scripts/check-docs.ts",
    "docs:dev": "npm --prefix site ci --no-audit --no-fund && npm --prefix site run dev",
    "docs:build": "npm --prefix site ci --no-audit --no-fund && npm --prefix site run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/luxon": "3.7.3",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.2",
    "@types/ws": "8.18.1",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "fastify": "5.11.0",
    "typescript": "7.0.2",
    "ws": "8.21.2"
  },
  "dependencies": {
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@nostrify/nostrify": "^0.54.0",
    "cron-parser": "^5.7.0",
    "handlebars": "^4.7.9",
    "jose": "^6.2.8",
    "luxon": "^3.7.2",
    "nostr-tools": "^2.24.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.0"
  }
}
