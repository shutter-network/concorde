{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "strict": true,
    "verbatimModuleSyntax": true,

    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,

    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["main.ts", "drizzle.config.ts", "schema.ts"]
}
