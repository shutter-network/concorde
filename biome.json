{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": ["**", "!src/db/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "pg": "The pool is the Db's alone: obtain a handle with db.handle(schema) instead. Fastify and Drizzle are public API; pg is not (ADR-0022)."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**", "!src/signatures/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "jose": "Building a JWS is Signatures' alone: ask it for one with signatures.sign(typ, claims). Decisions stores the string it answers with and never touches the format, and a second party assembling segments is a second chance to emit something nobody else can verify (ADR-0042)."
                }
              }
            }
          }
        }
      }
    }
  ]
}
