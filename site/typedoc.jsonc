{
  "$schema": "https://typedoc.org/schema.json",

  "name": "@shutter-network/concorde",

  "plugin": [
    "typedoc-plugin-markdown",
    "typedoc-vitepress-theme",
    "./specifier-titles.mjs",
    "./expanded-object-methods.mjs"
  ],

  "entryPoints": [
    "../src/gateway/index.ts",
    "../src/logging/index.ts",
    "../src/db/index.ts",
    "../src/signals/index.ts",
    "../src/pi/index.ts",
    "../src/users/index.ts",
    "../src/password-auth/index.ts",
    "../src/nostr-auth/index.ts",
    "../src/messenger/index.ts",
    "../src/http-channel/index.ts",
    "../src/nostr-channel/index.ts",
    "../src/signatures/index.ts",
    "../src/decisions/index.ts",
    "../src/scheduler/index.ts"
  ],
  "entryPointStrategy": "resolve",

  "tsconfig": "../tsconfig.build.json",

  "out": "./reference",
  "docsRoot": ".",

  "outputFileStrategy": "modules",
  "flattenOutputFiles": true,

  "disableSources": true,

  "readme": "none",
  "excludeExternals": true,
  "excludePrivate": true,
  "excludeInternal": true,

  "treatWarningsAsErrors": true,

  "hidePageHeader": true,
  "hideBreadcrumbs": true,

  "useCodeBlocks": true,

  "expandObjects": true,
  "theme": "expanded-objects"
}
